
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <ul>
        <% upcomingProjects.forEach(project => { %>
            <li>
                <%= project.date %>: <a href="/project/<%=project.project_id %>"><%= project.title %></a> (<a href="/organization/<%= project.organization_id %>"><%= project.name %></a>).
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
