
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <ul>
        <% upcomingProjects.forEach(project => { %>
            <li>
                <p><strong></strong><%= project.date %>:</strong> <a href="/project/<%=project.project_id %>"><%= project.title %></a> (<a href="/organization/<%= project.organization_id %>"><%= project.name %></a>).</p>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
