<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= projectDetails.title %>
        </h2>
        <p><strong>Description:</strong> <%= projectDetails.description %></p>
        <p><strong>Project Date:</strong> <%= projectDetails.date %></p>
        <p><strong>Project Location:</strong> <%= projectDetails.location %></p>
        <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.name %>
            </a></p>
        <ul>
            <strong>Categories For this Project:</strong>
            <% categoryDetails.forEach((category) => { %>
                <li><a href="/category/<%= category.category_id %>">
                        <%= category.category %>
                    </a></li>
            <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>