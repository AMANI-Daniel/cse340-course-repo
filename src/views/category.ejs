<%- include('partials/header') %>
<main>
    <h1>
        <%= title %>
    </h1>
    <h2>
        <%= categoryDetails.category %>
    </h2>
    <p><strong>Service Projects in this Category:</strong></p>
    <ul>
        <% projects.forEach(project=> { %>
    
            <li><a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a></li>
    
            <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>